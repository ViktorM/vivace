# Don't copy these into the image — they're large, unrelated, or local-only.
.venv
# .git kept in the image (small overhead, ~10-100 MB) so `git pull` works
# inside the container — lets us hot-patch trainer code on a running pod
# without rebuilding the image. Previously excluded; that turned out to be
# a workflow tax during multi-pod iteration on Runpod.
.github
runs
wandb
*.ipynb_checkpoints
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache
reviews
.codex
RL_gsm8k.ipynb
docs/superpowers
signal-desktop-keyring.gpg
signal-desktop.sources

# The Docker build uses docker/pyproject.cu128.toml + docker/uv.cu128.lock
# (copied into the image as pyproject.toml + uv.lock) to pin torch to cu128
# wheels. The project-root pyproject.toml + uv.lock target cu13 for local
# dev — keep them out of the build context so they can't shadow the cu128
# versions during `COPY . .`.
pyproject.toml
uv.lock
